From 30205ec64eaa797d72f4e8c8cbc3780510d2c4fe Mon Sep 17 00:00:00 2001
From: Naveen S <quic_naves@quicinc.com>
Date: Mon, 13 Jan 2025 12:39:33 +0530
Subject: [PATCH] QSDK:PROTOCOL: control-app: Add MBO OCE support

Currently while configuring the AP, the config for MBO has been added
generically like other configs using the tlv id TLV_MBO and used its value
in the format "mbo=tlv->value", resulting in the failure of
`CT_Optimization_Wi-FiAgileMultiband_AP_MBOAssociation_10372_1` testcase
But while enabling mbo, the config oce must also be set to 4, while
handling mbo generically this is not possible.

Add a special conditional block for tlv id TLV_MBO to set mbo and oce
configs as per the expectation.

Signed-off-by: Naveen S <quic_naves@quicinc.com>
Signed-off-by: Paulson Raja L <quic_lraja@quicinc.com>
---
 indigo_api_callback_dut.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

--- a/indigo_api_callback_dut.c
+++ b/indigo_api_callback_dut.c
@@ -314,6 +314,7 @@ static int generate_hostapd_config(char
     int semicolon_list_size = sizeof(semicolon_list) / sizeof(struct tlv_to_config_name);
     int hs20_icons_attached = 0;
     int is_multiple_bssid = 0;
+    int mbo = 0;
 
 #if HOSTAPD_SUPPORT_MBSSID
     if ((wlanp->mbssid_enable && !wlanp->transmitter) || (band_first_wlan[wlanp->band])) {
@@ -364,6 +365,21 @@ static int generate_hostapd_config(char
             }
             continue;
         }
+
+        if (tlv->id == TLV_MBO) {
+            memset(value, 0, sizeof(value));
+            if (tlv->len >= sizeof(value)) {
+                 continue;
+            }
+            memcpy(value, tlv->value, tlv->len);
+            value[tlv->len] = '\0';
+            mbo = atoi(value);
+            if (mbo) {
+                strlcat(output, "mbo=1\n", output_size);
+                strlcat(output, "oce=4\n", output_size);
+            }
+            continue;
+        }
 
         /* This is used when hostapd will use multiple lines to 
          * configure multiple items in the same configuration parameter
